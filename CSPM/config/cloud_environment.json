{
  "cloud": "AWS-SIMULATED",

  "compute": [
    {
      "id": "VM-01",
      "type": "VM",
      "public_ip": true,
      "criticality": 8,
      "security_group": "SG-01"
    },
    {
      "id": "VM-02",
      "type": "VM",
      "public_ip": false,
      "criticality": 5,
      "security_group": "SG-02"
    }
  ],

  "storage": [
    {
      "id": "BUCKET-01",
      "type": "Storage",
      "public": true,
      "encrypted": false,
      "sensitive_data": true
    }
  ],

  "databases": [
    {
      "id": "DB-01",
      "type": "Database",
      "public": true,
      "encrypted": false,
      "criticality": 10,
      "sensitive_data": true
    }
  ],

  "iam": [
    {
      "id": "USER-01",
      "type": "IAM User",
      "mfa": false,
      "unused": false,
      "privilege": "admin"
    }
  ],

  "network": [
    {
      "id": "SG-01",
      "type": "Security Group",
      "rules": [
        {
          "protocol": "TCP",
          "port": 22,
          "source": "0.0.0.0/0"
        }
      ]
    }
  ]
}